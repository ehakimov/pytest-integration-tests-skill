# Copy to .env: cp .env.example .env
# The values below work only with the demo stand (demo_stand/server.py). For your environment put real ones,
# and create the same names as CI/CD variables. .env is never committed.

# Environment from config.yml (the same as --env)
TEST_ENV=demo
# Autotest account: API login (profile contracts_admin) and UI user ui_users.operator
AUTOTEST_USERNAME=autotest
AUTOTEST_PASSWORD=autotest-pass
# Secret of the OAuth2 client contracts-api
CONTRACTS_CLIENT_SECRET=demo-client-secret
# Password for the web interface
UI_OPERATOR_PASSWORD=secret
