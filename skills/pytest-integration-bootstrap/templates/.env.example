# Copy to .env: cp .env.example .env. In CI create the same names as masked CI/CD variables.
# .env is never committed.

# Environment from config.yml (the same as --env)
TEST_ENV=staging
# Faker locale for generated data
FAKER_LOCALE=en_US

# Autotest account: API (profile api_admin) and UI (ui_users.operator)
AUTOTEST_USERNAME=
AUTOTEST_PASSWORD=
UI_OPERATOR_PASSWORD=
# OAuth2 clients
API_CLIENT_SECRET=
SERVICE_CLIENT_SECRET=
# Basic and API key profiles
PARTNER_USERNAME=
PARTNER_PASSWORD=
PUBLIC_API_KEY=
# Kafka
KAFKA_USERNAME=
KAFKA_PASSWORD=
